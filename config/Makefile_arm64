BUILD_DIR := build
KERNEL_DIR := src/kernel

ASM := clang
ASMFLAGS := --target=aarch64-unknown-elf
CC := gcc
CCFLAGS := -ffreestanding -fno-stack-protector -fno-pie -fno-asynchronous-unwind-tables -fno-unwind-tables -fno-builtin -fno-omit-frame-pointer -std=c11 -Wall -Werror -g -O2 -I./src/kernel --target=aarch64-unknown-elf
# bro too many args bro
LD := ld.lld

LIMINE_DIR := limine
LIMINE := $(LIMINE_DIR)/bin/limine

KERNEL := $(BUILD_DIR)/kernel.elf
IMAGE := $(BUILD_DIR)/dej-os.img
MNT := $(BUILD_DIR)/mnt

C_SOURCES := $(shell find src/kernel -name '*.c' \
	-not -path 'src/kernel/arch/x86/*')
C_OBJECTS := $(patsubst $(KERNEL_DIR)/%.c,$(BUILD_DIR)/%.o,$(C_SOURCES))

ASM_SOURCES := $(shell find src/kernel/arch/arm -name '*.asm')
ASM_OBJECTS := $(patsubst $(KERNEL_DIR)/%.asm,$(BUILD_DIR)/%.o,$(ASM_SOURCES))
.PHONY: all kernel image run clean

all: always image

kernel: $(KERNEL)


$(KERNEL): $(C_OBJECTS) $(ASM_OBJECTS) $(KERNEL_DIR)/main.c $(KERNEL_DIR)/arch/arm/linker.ld
	$(LD) -T $(KERNEL_DIR)/arch/arm/linker.ld -o $@ $(C_OBJECTS) $(ASM_OBJECTS)

$(BUILD_DIR)/%.o: $(KERNEL_DIR)/%.c
	$(CC) $(CCFLAGS) -c $< -o $@
$(BUILD_DIR)/%.o: $(KERNEL_DIR)/%.asm
	$(ASM) $(ASMFLAGS) -x assembler -c $< -o $@

image: $(IMAGE)

$(IMAGE): $(KERNEL) limine.conf

	rm -f $@

	dd if=/dev/zero of=$@ bs=1M count=64

	sgdisk -Z $@
	sgdisk -n 1:2048:0 -t 1:ef00 $@

	DEV=$$(hdiutil attach -imagekey diskimage-class=CRawDiskImage -nomount $@ | awk 'NR==1 {print $$1}'); \
	echo $$DEV > $(BUILD_DIR)/diskdev

	sudo newfs_msdos -F 32 -v DEJOS $$(cat $(BUILD_DIR)/diskdev)s1

	mkdir -p $(MNT)
	sudo mount -t msdos $$(cat $(BUILD_DIR)/diskdev)s1 $(MNT)

	sudo mkdir -p $(MNT)/boot
	sudo mkdir -p $(MNT)/EFI/BOOT
	sudo cp $(KERNEL) $(MNT)/boot/kernel.elf
	sudo cp limine.conf $(MNT)/limine.conf
	sudo cp $(LIMINE_DIR)/bin/BOOTAA64.EFI $(MNT)/EFI/BOOT/BOOTAA64.EFI

	sudo umount $(MNT)
	sudo hdiutil detach $$(cat $(BUILD_DIR)/diskdev)
	rm -f $(BUILD_DIR)/diskdev

run: image
	qemu-system-x86_64 -drive format=raw,file=$(IMAGE)

always:
	mkdir -p build/dej
	mkdir -p build/keyboard
	mkdir -p build/interrupt
	mkdir -p build/memory
	mkdir -p build/arch/arm/interrupt
	mkdir -p build/cpu/cpu1/

clean:
	sudo umount $(MNT) 2>/dev/null || true
	rm -rf $(BUILD_DIR)
